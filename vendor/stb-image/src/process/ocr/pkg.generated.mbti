  peaks : Array[Int]
  valleys : Array[Int]
  mean : Double
  stddev : Double
}

pub(all) struct PunctuationTemplate {
  char : String
  features : Array[Double]
  width_ratio : Double
}

pub(all) struct RobustnessReport {
  overall_score : Double
  quality_score : Double
  distortion_score : Double
  layout_complexity_score : Double
  noise_resistance_score : Double
  recommendations : Array[String]
  estimated_accuracy : Double
  processing_recommendation : String
}

pub(all) struct ScanOCRConfig {
  language : String
  dpi : Int
  deskew : Bool
  denoise : Bool
  binarization_method : String
  layout_analysis : Bool
  confidence_threshold : Double
}

pub(all) struct ScanQuality {
  brightness : Double
  contrast : Double
  sharpness : Double
  noise_level : Double
  skew_angle : Double
  overall_score : Double
  issues : Array[String]
}

pub(all) enum ScanQualityLevel {
  Excellent
  Good
  Fair
  Poor
  VeryPoor
} derive(Eq)

pub(all) struct SimilarCharMapping {
  char : String
  similar_chars : Array[String]
  context_hint : String
}

pub(all) struct SplitPoint {
  x : Int
  y_top : Int
  y_bottom : Int
  confidence : Double
}

pub(all) struct StatisticalFeatures {
  mean : Double
  std : Double
  skewness : Double
  kurtosis : Double
  entropy : Double
  energy : Double
  contrast : Double
  homogeneity : Double
}

pub(all) struct StrokeFeature {
  stroke_type : StrokeType
  start_x : Double
  start_y : Double
  end_x : Double
  end_y : Double
  length : Double
  angle : Double
  curvature : Double
  pressure : Double
}

pub(all) struct StrokeSegmentationResult {
  num_strokes : Int
  strokes : Array[StrokeFeature]
  segmentation_points : Array[(Int, Int)]
  confidence : Double
}

pub(all) enum StrokeType {
  Horizontal
  Vertical
  LeftFalling
  RightFalling
  Dot
  Hook
  Turning
  Rising
  Unknown
} derive(Eq)

pub(all) struct TableCell {
  x : Int
  y : Int
  width : Int
  height : Int
  row : Int
  col : Int
  row_span : Int
  col_span : Int
}

pub(all) struct TableCellContent {
  row : Int
  col : Int
  row_span : Int
  col_span : Int
  x : Int
  y : Int
  width : Int
  height : Int
  text : String
  is_header : Bool
  is_merged : Bool
}

pub(all) struct TableDetectionResult {
  horizontal_lines : Array[(Int, Int, Int)]
  vertical_lines : Array[(Int, Int, Int)]
  intersections : Array[(Int, Int)]
  num_rows : Int
  num_cols : Int
  confidence : Double
}

pub(all) struct TableLine {
  x1 : Int
  y1 : Int
  x2 : Int
  y2 : Int
  line_type : TableLineType
  thickness : Int
}

pub(all) enum TableLineType {
  Horizontal
  Vertical
} derive(Eq)

pub(all) struct TableStructure {
  rows : Int
  cols : Int
  cells : Array[TableCell]
  horizontal_lines : Array[TableLine]
  vertical_lines : Array[TableLine]
  bounding_box : (Int, Int, Int, Int)
}

pub(all) struct TemplateMatcher {
  templates : Array[(String, Array[Double])]
  distance_metric : String
}

pub(all) struct TextBlock {
  x : Int
  y : Int
  width : Int
  height : Int
  block_type : String
  text : String
  confidence : Double
  reading_order : Int
}

pub(all) struct TextLine {
  x : Int
  y : Int
  width : Int
  height : Int
}

pub(all) struct TextLineAttributes {
  x : Int
  y : Int
  width : Int
  height : Int
  font_size : Double
  font_weight : String
  is_indented : Bool
  indent_level : Int
  line_spacing : Double
  text : String
  alignment : String
}

pub(all) struct TextLineInfo {
  y_start : Int
  y_end : Int
  height : Int
  x_start : Int
  x_end : Int
  width : Int
  pixel_count : Int
  baseline : Int
}

pub(all) struct TextRegion {
  x : Int
  y : Int
  width : Int
  height : Int
  region_type : TextRegionType
}

pub(all) enum TextRegionType {
  Text
  Image
  Table
  Unknown
} derive(Eq)

pub(all) struct TrainingConfig {
  epochs : Int
  batch_size : Int
  optimizer : OptimizerConfig
  lr_scheduler : LRSchedulerConfig
  augmentation : AugmentationConfig
  early_stopping_patience : Int
  early_stopping_min_delta : Double
  save_best_only : Bool
  checkpoint_interval : Int
  log_interval : Int
  validation_split : Double
  shuffle : Bool
  random_seed : Int
}

pub(all) struct TrainingDataset {
  samples : Array[TrainingSample]
  labels : Array[String]
  num_samples : Int
  num_classes : Int
}

pub(all) struct TrainingMetrics {
  epoch : Int
  train_loss : Double
  train_accuracy : Double
  val_loss : Double
  val_accuracy : Double
  learning_rate : Double
  time_ms : Double
  is_best : Bool
}

pub(all) struct TrainingSample {
  features : Array[Double]
  label : String
}

pub(all) struct TrainingState {
  current_epoch : Int
  best_val_accuracy : Double
  best_epoch : Int
  epochs_without_improvement : Int
  total_training_time_ms : Double
  history : Array[TrainingMetrics]
  is_completed : Bool
  stop_reason : String
}

